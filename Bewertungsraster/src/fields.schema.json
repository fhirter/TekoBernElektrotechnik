{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "array",
    "items": {
        "type": "object",
        "required": ["label", "inputs"],
        "properties": {
            "label": { "type": "string" },
            "bonus": { "type": "boolean" },
            "description": { "type": "string" },
            "inputs": {
                "type": "array",
                "items": {
                    "type": "object",
                    "required": ["label", "min", "max"],
                    "properties": {
                        "label": { "type": "string" },
                        "min": { "type": "number" },
                        "max": { "type": "number" },
                        "description": { "type": "string" }
                    },
                    "additionalProperties": false
                }
            }
        },
        "additionalProperties": false
    }
}